---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;
---
<meta charset="utf-8" />
<title>BEN WHO?</title>
<meta name="theme-color" content="lime" />
<link rel="icon"         href="/favicon.svg" type="image/svg+xml" data-theme="fight" style="color: hotpink;" />
<link rel="icon"         href="/favicon.ico" />
<link rel="dns-prefetch" href="//files.benmirkhah.com">
<link rel="dns-prefetch" href="//media.benmirkhah.com">
<link rel="preconnect"   href="https://files.benmirkhah.com" crossorigin />
<link rel="preconnect"   href="https://media.benmirkhah.com" crossorigin />
<link rel="canonical"    href={canonicalURL} />
<link rel="shortlink"    href="https://benmirkhah.com/">
<link rel="sitemap"      href="/sitemap-index.xml" />
<Font cssVariable="--font-atkinson" preload />
<meta name="description"        content={description} />
<meta name="viewport"           content="width=device-width,initial-scale=1" />
<meta name="HandheldFriendly"   content="true">
<meta name="MobileOptimized"    content="width">
<meta name="robots"             content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
<meta name="twitter:card"       content="summary_large_image" />
<meta name="twitter:title"      content="Who is Ben Mirkhah?" />
<meta name="twitter:site"       content="@drupalati" />
<meta name="twitter:image"      content="https://media.benmirkhah.com/benmirkhah.webp?v3" />
<meta property="og:title"       content="Who is Ben Mirkhah?" />
<meta property="og:type"        content="website" />
<meta property="og:url"         content="https://whois.benmirkhah.com" />
<meta property="og:image"       content="https://media.benmirkhah.com/benmirkhah.webp?v3" />
<meta property="og:description" content={description} />
<meta property="test"           content={title} />
