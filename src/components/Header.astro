---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="home" href="/">BEN WHO?</a>
		<div class="navlinks">
			<HeaderLink href="/uix" id="luid">Designer</HeaderLink>
			<HeaderLink href="/dev" id="ldev">Developer</HeaderLink>
			<HeaderLink href="/etc" id="letc">etc.</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: #FFF9;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		padding: 0 10px;
		font-size: 16px;
		height: 40px;
		line-height: 40px;
	}

	nav a.active {
		background-color: black;
		color: white;
	}

	nav a.home {
		/* display: block; */
		font-size: 20px;
		color: var(--ch2);
	}
</style>
