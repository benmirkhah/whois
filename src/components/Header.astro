---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="home" href="/">BEN WHO?</a>
		<div class="navlinks">
			<HeaderLink href="/uix" id="uid">Designer</HeaderLink>
			<HeaderLink href="/dev" id="dev">Developer</HeaderLink>
			<HeaderLink href="/dir" id="dir">Director</HeaderLink>
			<HeaderLink href="/etc" id="etc">etc.</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: #FFF6;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		padding: 0 10px;
		font-size: 15px;
		height: 30px;
		line-height: 30px;
	}

	nav a.active {
		background-color: #FFF6;
		color: #000;
	}

	nav a.home {
		font-size: 20px;
		color: var(--ch2);
	}
</style>
